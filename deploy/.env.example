# 复制为 .env 后填写，然后 docker compose up -d

# --- 必填 ---------------------------------------------------------------

# 管理页登录密码。用于 http://主机:8317 的 cookie 会话登录。
RELAY_ADMIN_PASSWORD=

# 状态加密密钥，加密落盘的 state.enc（AES-256-GCM）。
# 生成：docker run --rm painwind/qoder-relay-web:latest keygen
# 换掉它等于丢掉全部账号与密钥，务必单独备份。
RELAY_MASTER_KEY=

# --- 可选 ---------------------------------------------------------------

# 主监听端口（管理页 + 通用 /v1 网关），容器内固定 8317。
QODER_PORT=8317

# 内置反代端口：只在管理页「设置 → 开启反代」后才会真正监听。
QODER_PORT_CN=7891
QODER_PORT_INTL=7892

# 数据卷名，改名等于换一份空数据集
QODER_VOLUME=qoder-relay-data

# 未在请求头或请求体里指定档位时使用哪个档位：domestic | international
RELAY_DEFAULT_EDITION=domestic

# 每日自动签到（默认开启，08:30 本地时间）
RELAY_CHECKIN_ENABLED=true
RELAY_CHECKIN_HOUR=8
RELAY_CHECKIN_MINUTE=30

# 用 HTTPS 反向代理暴露控制台时设为 true，cookie 才会带 Secure。
RELAY_SECURE_COOKIE=false

# 国际版签到需要真实桌面端机器身份。容器内拿不到 Qoder 客户端的
# runtime-info 原生桥，派生身份会被服务端整条过滤，所以只能手工填。
# 从已登录的 Qoder 桌面端抓取后填入，三项需同时存在才生效。
QODER_MACHINE_TOKEN=
QODER_MACHINE_TYPE=
QODER_MACHINE_CODE=

TZ=Asia/Shanghai
